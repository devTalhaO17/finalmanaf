# Copy this file to client/.env and fill in your real values
# (client/.env is gitignored - never commit real keys)

# From Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: legacy Express API base (only used if you keep the old server)
VITE_API_URL=http://localhost:5000/api